{
  "name": "@narumitw/pi-langfuse",
  "version": "0.53.3",
  "description": "Pi extension that traces LLM generations and tool activity to Langfuse.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    }
  },
  "private": false,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "langfuse",
    "observability",
    "tracing"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "prepack": "npm run build",
    "check": "npm run build && biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-durable": "^1.2.0",
    "@earendil-works/chord": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/chord": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/chord": "1.3.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.66.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/otlp-exporter-base": "^0.300.0",
    "@opentelemetry/otlp-transformer": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-extensions",
    "directory": "packages/pi-langfuse"
  }
}
